{
  "Environment": "Development",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sariff_db;Username=postgres;Password=postgres123"
  },
  "Jwt": {
    "SecretKey": "DevSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "SARIFF",
    "Audience": "SARIFF-Users",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:5173", "http://localhost:5000"]
  },
  "Waha": {
    "BaseUrl": "http://localhost:3001",
    "ApiKey": "your-dev-api-key",
    "Session": "default",
    "Enabled": false,
    "WebsiteUrl": "http://localhost:5173"
  },
  "AfricasTalking": {
    "Username": "sandbox",
    "ApiKey": "atsk_266aca47f6183e4155d7947ec130a0a001101919388606ef8220ef267888ec0396864075",
    "SenderId": "SARIFF",
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "SARIFF": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sariff-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*"
}